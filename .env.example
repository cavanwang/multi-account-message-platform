# backend 环境变量示例。复制为 .env 后使用（.env 不提交）。
# 注意：docker-compose 运行时这些变量由 compose 文件注入，本文件仅供宿主机本地开发参考。

# 后端监听端口
PORT=3000

# PostgreSQL 连接串
# - 宿主机直接跑（npm run dev）时用 localhost
# - 容器内运行时用服务名 db（compose 已注入，无需修改本文件）
DATABASE_URL=postgres://app:app@localhost:5432/app

# 外部服务地址（切片 1 / 切片 5 实现）
GATEWAY_URL=http://localhost:3100
AGENT_URL=http://localhost:3200

# access token 签名密钥。生产环境务必替换为强随机值。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me

# access token 有效期（秒），默认 900 = 15 分钟
ACCESS_TOKEN_TTL_SECONDS=900

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# C1 媒体（选做）：本地下载目录、保留天数、清理扫描周期（秒）
MEDIA_DIR=/app/media
MEDIA_RETENTION_DAYS=30
MEDIA_CLEAN_INTERVAL_SECONDS=3600
